@model OfferComparisonViewModel
@{
    ViewData["Title"] = "مقایسه پیشنهادها";
    var req = Model.Requirement;
}
<div class="pagehead">
    <div>
        <p class="eyebrow">O2BAN / DECISION SUPPORT</p>
        <h1>مقایسه و ارزیابی پیشنهادها</h1>
        <p>@req.RequestCode · @req.Item?.Name · مقدار @req.Quantity @req.Item?.Unit</p>
    </div>
    <a class="btn" asp-action="Offers" asp-route-id="@req.Id">بازگشت به پیشنهادها</a>
</div>
<div class="notice">
    این تحلیل، ابزار پشتیبان تصمیم است و انتخاب خودکار تأمین‌کننده انجام نمی‌دهد. فقط آخرین نسخه هر تأمین‌کننده مقایسه شده است؛ نسخه‌های قبلی برای حفظ سابقه باقی می‌مانند.
</div>
<div class="stats">
    <div class="stat"><span>تأمین‌کنندگان دارای پیشنهاد</span><strong>@Model.OfferCount</strong></div>
    <div class="stat"><span>پیشنهادهای منقضی</span><strong>@Model.ExpiredCount</strong></div>
    <div class="stat"><span>مبنای قیمت</span><strong style="font-size:18px">قیمت کل</strong></div>
    <div class="stat"><span>تصمیم نهایی</span><strong style="font-size:18px">کارشناس خرید</strong></div>
</div>
<div class="panel">
    <div class="panelhead"><h2>امتیازدهی شفاف</h2><span class="tag">مجموع ۱۰۰ امتیاز</span></div>
    <table>
        <thead><tr><th>معیار</th><th>وزن</th><th>روش محاسبه</th></tr></thead>
        <tbody>
            <tr><td>قیمت کل</td><td>۳۰</td><td>قیمت کل کمتر، امتیاز بیشتر</td></tr>
            <tr><td>زمان تحویل</td><td>۲۰</td><td>زمان تحویل کوتاه‌تر، امتیاز بیشتر</td></tr>
            <tr><td>وضعیت فنی</td><td>۳۰</td><td>تأیید فنی ۳۰، نیازمند بررسی ۱۵، ردشده صفر</td></tr>
            <tr><td>شواهد تأمین‌کننده</td><td>۱۰</td><td>تأیید مستقل ۱۰، مستندات ۷، اظهار تأمین‌کننده ۴</td></tr>
            <tr><td>اعتبار پیشنهاد</td><td>۱۰</td><td>اعتبار بیش از سه روز ۱۰، سه روز یا کمتر ۵، منقضی صفر</td></tr>
            <tr><td>شرایط پرداخت</td><td>کیفی</td><td>نمایش کنار هم؛ تا زمان تعریف ترجیح خریدار، امتیازدهی خودکار نمی‌شود</td></tr>
        </tbody>
    </table>
</div>
@if (!Model.Offers.Any())
{
    <div class="panel">برای این درخواست هنوز پیشنهادی ثبت نشده است.</div>
}
else
{
    <div class="panel">
        <div class="panelhead"><h2>نتیجه مقایسه تأمین‌کنندگان</h2><span class="tag">رتبه‌بندی تحلیلی، نه انتخاب قطعی</span></div>
        <table class="comparison-table">
            <thead><tr><th>تأمین‌کننده</th><th>امتیاز</th><th>قیمت واحد</th><th>قیمت کل</th><th>تحویل</th><th>پرداخت</th><th>وضعیت فنی</th><th>شواهد</th><th>اعتبار تا</th><th>ارزیابی</th></tr></thead>
            <tbody>
            @foreach (var o in Model.Offers)
            {
                <tr class="@(o.IsExpired ? "expired-row" : "")">
                    <td><strong>@o.SupplierName</strong><small>نسخه @o.Version</small></td>
                    <td><strong class="score">@o.TotalScore / ۱۰۰</strong><small>قیمت @o.PriceScore · تحویل @o.DeliveryScore · فنی @o.TechnicalScore · شواهد @o.EvidenceScore · اعتبار @o.ValidityScore</small></td>
                    <td>@o.UnitPrice.ToString("N0")</td>
                    <td><strong>@o.TotalPrice.ToString("N0")</strong></td>
                    <td>@o.DeliveryDays روز</td>
                    <td class="payment-cell">@o.PaymentTerms</td>
                    <td>@o.TechnicalStatus</td>
                    <td>@o.EvidenceStatus</td>
                    <td>@o.ValidUntil.ToString("yyyy/MM/dd")</td>
                    <td>@o.Assessment</td>
                </tr>
                <tr class="warning-row"><td colspan="10"><strong>نکات بررسی:</strong> @string.Join(" | ", o.Warnings)</td></tr>
            }
            </tbody>
        </table>
    </div>
}
<div class="notice">
    <strong>محدودیت فعلی موتور:</strong> شرایط پرداخت به دلیل متنی و آزاد بودن، صرفاً نمایش داده می‌شود و امتیاز نمی‌گیرد. برای امتیازدهی منصفانه باید ترجیح خریدار (مانند نقدی، چک مدت‌دار، پیش‌پرداخت و سقف مهلت) به فیلدهای ساختاریافته تبدیل شود. همچنین تأیید فنی و شواهد، بر اساس وضعیت ثبت‌شده در سامانه امتیاز می‌گیرند و جایگزین بررسی مستندات واقعی نیستند.
</div>
