@model PurchaseRequirement
<h1>ثبت درخواست خرید</h1><form method="post" class="panel formgrid"><label>کالا / قلم<select asp-for="CatalogItemId" asp-items="ViewBag.Items"><option value="">انتخاب کالا / قلم</option></select></label><label>مقدار موردنیاز<input asp-for="Quantity" type="number" min="0.01" step="0.01" /></label><label>تاریخ موردنیاز<input asp-for="NeededBy" type="date" /></label><label>وضعیت<select asp-for="Status"><option>ثبت اولیه</option><option>در حال بررسی</option><option>ارسال برای استعلام</option><option>تکمیل شده</option></select></label><label class="wide">مشخصات و الزامات فنی<textarea asp-for="Specifications" placeholder="استاندارد، جنس، ابعاد، تلرانس، بسته‌بندی و مدارک موردنیاز..."></textarea></label><span asp-validation-summary="All"></span><button class="btn">ثبت درخواست</button></form>
