@model IEnumerable<O2Ban.EnterprisePilot.Controllers.UserRow>
<div class="pagehead"><div><p class="eyebrow">ACCESS CONTROL</p><h1>مدیریت کاربران</h1><p>ایجاد حساب برای اعضای مجاز پایلوت؛ ثبت‌نام عمومی غیرفعال است.</p></div></div>
@if(TempData["UserError"] is string error){<div class="notice">@error</div>} @if(TempData["UserSuccess"] is string success){<div class="notice">@success</div>}
<div class="panel"><h2>افزودن کاربر</h2><form method="post" asp-action="Create" class="formgrid"><label>ایمیل / نام کاربری<input name="email" type="email" required maxlength="256" /></label><label>نام نمایشی<input name="displayName" required maxlength="120" /></label><label>گذرواژه موقت قوی<input name="password" type="password" required minlength="12" autocomplete="new-password" /></label><label>نقش<select name="role"><option value="Procurement">کارشناس تأمین</option><option value="Admin">مدیر سامانه</option></select></label><button class="btn" type="submit">ایجاد کاربر</button></form><p class="muted">گذرواژه را از کانال امن تحویل دهید و پس از ورود تغییر آن را الزامی کنید.</p></div>
<div class="panel"><h2>کاربران موجود</h2><table><thead><tr><th>ایمیل</th><th>نام</th><th>نقش</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Email</td><td>@u.DisplayName</td><td>@(u.Role=="Admin"?"مدیر سامانه":"کارشناس تأمین")</td></tr>}</tbody></table></div>
