@model O2Ban.EnterprisePilot.Models.ValidationReportViewModel
<div class="pagehead"><div><div class="eyebrow">ENTERPRISE PILOT PERFORMANCE</div><h1>گزارش اعتبارسنجی</h1><p>گزارش فعالیت کاربران، درخواست‌های خرید، پیشنهادها، شواهد و بازخوردها</p></div><button class="btn" onclick="window.print()" type="button">چاپ / ذخیره PDF</button></div>
<form method="get" class="panel search"><label>از تاریخ<input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/></label><label>تا تاریخ<input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/></label><button class="btn">اعمال بازه</button></form>
<p class="notice">بازه گزارش: @Model.From.ToString("yyyy/MM/dd") تا @Model.To.ToString("yyyy/MM/dd") — آمار فعالیت بر اساس تاریخ ثبت هر رکورد محاسبه شده است.</p>
<div class="stats"><div class="stat"><span>کاربران ثبت‌شده</span><strong>@Model.ActiveUsers</strong></div><div class="stat"><span>درخواست خرید جدید</span><strong>@Model.RequirementsCreated</strong></div><div class="stat"><span>پیشنهاد ثبت‌شده</span><strong>@Model.OffersSubmitted</strong></div><div class="stat"><span>تأمین‌کنندگان</span><strong>@Model.SuppliersRegistered</strong></div></div>
<div class="stats"><div class="stat"><span>شواهد ثبت‌شده در بازه</span><strong>@Model.EvidenceTotal</strong></div><div class="stat"><span>در انتظار بررسی / به‌روزرسانی</span><strong>@Model.EvidencePending</strong></div><div class="stat"><span>تأیید مستقل / معامله‌محور</span><strong>@Model.EvidenceVerified</strong></div><div class="stat"><span>شواهد ردشده</span><strong>@Model.EvidenceRejected</strong></div></div>
<div class="stats"><div class="stat"><span>سفارش‌های ثبت‌شده</span><strong>@Model.OrdersCreated</strong></div><div class="stat"><span>تحویل کامل در بازه</span><strong>@Model.OrdersDelivered</strong></div><div class="stat"><span>ارزیابی‌های تأمین‌کننده</span><strong>@Model.OrdersEvaluated</strong></div><div class="stat"><span>میانگین عملکرد تأمین‌کننده</span><strong>@(Model.AverageSupplierPerformance?.ToString("0.0") ?? "—")</strong></div></div>
<div class="result-columns"><section class="panel"><h2>وضعیت شواهد</h2><table><thead><tr><th>وضعیت</th><th>تعداد</th></tr></thead><tbody>@foreach(var x in Model.EvidenceByStatus){<tr><td>@x.Status</td><td>@x.Count</td></tr>}@if(!Model.EvidenceByStatus.Any()){<tr><td colspan="2">داده‌ای در این بازه وجود ندارد.</td></tr>}</tbody></table></section><section class="panel"><h2>بازخورد کاربران</h2><div class="stats"><div class="stat"><span>تعداد بازخورد</span><strong>@Model.FeedbackCount</strong></div><div class="stat"><span>میانگین امتیاز</span><strong>@(Model.AverageRating?.ToString("0.0") ?? "—") / ۵</strong></div></div><table><thead><tr><th>حوزه</th><th>تعداد</th><th>میانگین</th></tr></thead><tbody>@foreach(var x in Model.FeedbackByArea){<tr><td>@x.Area</td><td>@x.Count</td><td>@x.AverageRating.ToString("0.0")</td></tr>}@if(!Model.FeedbackByArea.Any()){<tr><td colspan="3">بازخوردی ثبت نشده است.</td></tr>}</tbody></table></section></div>
<div class="panel"><h2>آخرین بازخوردها</h2><table><thead><tr><th>تاریخ</th><th>حوزه</th><th>امتیاز</th><th>نظر</th></tr></thead><tbody>@foreach(var x in Model.RecentFeedback){<tr><td>@x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@x.Area</td><td>@x.Rating / ۵</td><td class="payment-cell">@x.Comment</td></tr>}@if(!Model.RecentFeedback.Any()){<tr><td colspan="4">بازخوردی ثبت نشده است.</td></tr>}</tbody></table></div>
<div class="notice">این گزارش شاخص‌های عملیاتی اعتبارسنجی را نمایش می‌دهد؛ به‌تنهایی اثبات‌کننده صرفه‌جویی مالی، کیفیت تأمین یا موفقیت تجاری نیست. برای این نتایج باید قیمت مبنا، زمان چرخه خرید، کیفیت تحویل و معاملات واقعی نیز ثبت و مقایسه شوند.</div>
<style>@@media print{.topbar,footer,.btn,form{display:none!important}body{background:#fff}.container{max-width:none;margin:0;padding:0}.panel,.stat{break-inside:avoid}}</style>
