<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>O2Ban Pilot | مدیریت تأمین سازمانی</title>
<link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index">O2Ban <span>Pilot</span></a>
<nav>
<a asp-controller="Home" asp-action="Index">داشبورد</a>
<a asp-controller="Catalog" asp-action="Index">کالاها و اقلام</a>
<a asp-controller="Suppliers" asp-action="Index">تأمین‌کنندگان</a>
<a asp-controller="Requirements" asp-action="Index">درخواست‌های خرید</a>
<a asp-controller="SupplierPerformance" asp-action="Index">عملکرد تأمین‌کنندگان</a>
<a asp-controller="Evidence" asp-action="Index">شواهد</a>
<a asp-controller="Feedback" asp-action="Index">بازخورد</a>
@if (User.IsInRole("Admin")) { <a asp-controller="ValidationReports" asp-action="Index">گزارش اعتبارسنجی</a><a asp-controller="Users" asp-action="Index">مدیریت کاربران</a> }
</nav>
<div class="userbox">@User.Identity?.Name <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">تغییر گذرواژه</a> <form method="post" asp-area="Identity" asp-page="/Account/Logout"><button class="linkbtn">خروج</button></form></div>
</header>
<main class="container">@RenderBody()</main>
<footer>O2Ban Pilot · محصول مستقل · نسخه آزمایشی کنترل‌شده</footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
