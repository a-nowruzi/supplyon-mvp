@model UserFeedback
<h1>ثبت بازخورد</h1><form method="post" class="panel formgrid"><label>بخش مورد ارزیابی<select asp-for="Area"><option>جست‌وجوی کالا / قلم</option><option>اطلاعات تأمین‌کننده</option><option>ثبت درخواست خرید</option><option>ثبت پیشنهاد</option><option>مقایسه پیشنهادها</option><option>سهولت استفاده</option><option>سایر</option></select></label><label>امتیاز از ۱ تا ۵<input asp-for="Rating" type="number" min="1" max="5" /></label><label class="wide">نظر و پیشنهاد اصلاحی<textarea asp-for="Comment" required></textarea></label><button class="btn">ثبت بازخورد</button></form>
