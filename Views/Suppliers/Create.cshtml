@model Supplier
<h1>افزودن تأمین‌کننده آزمایشی</h1><form method="post" class="panel formgrid"><label>نام شرکت<input asp-for="Name" /></label><label>شناسه ملی (اختیاری)<input asp-for="NationalId" /></label><label>شهر<input asp-for="City" /></label><label>نام رابط<input asp-for="ContactName" /></label><label class="wide">توانمندی‌ها<textarea asp-for="Capabilities"></textarea></label><label>وضعیت شواهد<select asp-for="EvidenceStatus"><option>اظهار تأمین‌کننده</option><option>مدرک دریافت شده</option><option>تأیید مستقل</option><option>نیازمند بررسی</option><option>متناقض</option></select></label><button class="btn">ذخیره</button></form>
