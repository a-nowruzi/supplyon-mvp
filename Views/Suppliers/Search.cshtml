@model SupplierSearchViewModel
<div class="pagehead">
    <div><p class="eyebrow">SUPPLIER INTELLIGENCE ENGINE</p><h1>جست‌وجوی هوشمند تأمین‌کننده</h1><p>تطبیق چندمعیاره و توضیح‌پذیر بر اساس اطلاعات ثبت‌شده تأمین‌کنندگان</p></div>
    <a class="btn" asp-action="Index">فهرست تأمین‌کنندگان</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.RequirementCode))
{
    <div class="notice">جست‌وجو برای درخواست <strong>@Model.RequirementCode</strong> · کالا / قلم: @Model.ItemName · مقدار: @Model.Quantity</div>
}
<form method="get" asp-action="Search" class="panel">
    @if (Model.RequirementId.HasValue) { <input type="hidden" name="requirementId" value="@Model.RequirementId" /> }
    <div class="formgrid">
        <label class="wide">شرح نیاز یا مشخصات کالا / قلم
            <textarea name="q" placeholder="مثلاً کالا / قلم فلزی پرس‌کاری، براکت، مجموعه جوشکاری...">@Model.Query</textarea>
        </label>
        <label>کد کالا<input name="itemCode" value="@Model.ItemCode" placeholder="کد کالا" /></label>
        <label>دسته‌بندی<input name="category" value="@Model.Category" placeholder="مثلاً کالاها و اقلام فلزی" /></label>
        <label>حوزه کاربرد<input name="industrySegment" value="@Model.IndustrySegment" placeholder="نام حوزه کاربرد یا صنعت" /></label>
        <label>مقدار موردنیاز<input name="quantity" type="number" min="0" step="0.01" value="@Model.Quantity" /></label>
    </div>
    <div style="margin-top:16px;display:flex;gap:10px;align-items:center"><button class="btn" type="submit">تحلیل و جست‌وجو</button><a asp-action="Search" asp-route-requirementId="@Model.RequirementId">پاک‌کردن فیلترها</a></div>
</form>
<div class="notice"><strong>نحوه تفسیر نتایج:</strong> امتیاز، میزان ارتباط متنی اطلاعات ثبت‌شده را نشان می‌دهد؛ نه تأیید توان فنی، ظرفیت تولید یا صلاحیت قطعی تأمین‌کننده. تأیید نهایی باید توسط کارشناس و بر اساس مدارک انجام شود.</div>
@if (Model.Results.Count > 0)
{
    <div class="panelhead"><h2>نتایج جست‌وجو</h2><span class="tag">@Model.Results.Count نتیجه از @Model.TotalSuppliers تأمین‌کننده</span></div>
    @foreach (var item in Model.Results)
    {
        <section class="panel supplier-result">
            <div class="supplier-result-head">
                <div><h2>@item.Supplier.Name</h2><p>@item.Supplier.City · <span class="tag">@item.RelevanceLabel</span></p></div>
                <div class="supplier-score"><strong>@item.RelevanceScore</strong><small>از ۱۰۰ · ارتباط متنی</small></div>
            </div>
            <div class="result-columns">
                <div><h3>دلایل تطبیق</h3>
                    @if (item.MatchReasons.Count == 0) { <p class="muted">تطبیق معناداری در متن ثبت‌شده پیدا نشد.</p> }
                    else { <ul>@foreach (var reason in item.MatchReasons) { <li>@reason</li> }</ul> }
                </div>
                <div><h3>اطلاعات نیازمند تکمیل</h3><ul>@foreach (var gap in item.DataGaps) { <li>@gap</li> }</ul></div>
            </div>
            <p class="evidence-note"><strong>وضعیت شواهد:</strong> @item.EvidenceInterpretation</p>
            <p class="evidence-note"><strong>سابقه عملکرد:</strong>
            @if (item.HistoricalPerformanceScore.HasValue) { <text>@item.HistoricalPerformanceScore.Value.ToString("0.0") از ۱۰۰ · @item.PerformanceHistoryLabel</text> }
            else { <text>فاقد سابقه ارزیابی پس از معامله؛ این وضعیت به معنی عملکرد ضعیف نیست.</text> }
            · <a asp-controller="SupplierPerformance" asp-action="SupplierProfile" asp-route-supplierId="@item.Supplier.Id">مشاهده پروفایل عملکرد</a></p>
            <p class="muted">توانمندی ثبت‌شده: @(string.IsNullOrWhiteSpace(item.Supplier.Capabilities) ? "ثبت نشده" : item.Supplier.Capabilities)</p>
        </section>
    }
}
else if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.ItemCode) || !string.IsNullOrWhiteSpace(Model.Category) || !string.IsNullOrWhiteSpace(Model.IndustrySegment))
{
    <div class="panel"><h2>نتیجه‌ای پیدا نشد</h2><p>در اطلاعات فعلی تأمین‌کنندگان، تطبیق متنی پیدا نشد. ممکن است اطلاعات توانمندی ناقص باشد یا تأمین‌کننده مرتبط هنوز در سامانه ثبت نشده باشد.</p></div>
}
else
{
    <div class="panel"><h2>برای شروع جست‌وجو، معیار وارد کنید</h2><p>می‌توانید شرح نیاز را بنویسید یا از صفحه درخواست خرید، جست‌وجو را مستقیماً برای یک درخواست اجرا کنید.</p></div>
}
