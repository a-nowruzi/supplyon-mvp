@model IEnumerable<O2Ban.EnterprisePilot.Models.EvidenceRecord>
<div class="pagehead"><div><div class="eyebrow">EVIDENCE MANAGEMENT</div><h1>مدیریت شواهد</h1><p>ثبت، پیگیری و بررسی مدارک و ادعاهای مرتبط با تأمین‌کنندگان و درخواست‌های خرید</p></div><a class="btn" asp-action="Create">ثبت مدرک یا ادعا</a></div>
<form method="get" class="panel search"><select name="status"><option value="">همه وضعیت‌ها</option>@foreach(var s in new[]{"در انتظار بررسی","اظهار تأمین‌کننده","استخراج‌شده از سند","تأیید مستقل","مبتنی بر معامله","نیازمند به‌روزرسانی","متناقض","مشکوک","ردشده"}){<option value="@s" selected="@((ViewBag.Status as string) == s)">@s</option>}</select><select name="supplierId" asp-items="ViewBag.Suppliers"><option value="">همه تأمین‌کنندگان</option></select><button class="btn" type="submit">فیلتر</button></form>
<div class="panel"><table><thead><tr><th>عنوان</th><th>نوع</th><th>مرتبط با</th><th>منبع</th><th>وضعیت</th><th>تاریخ ثبت</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Title</td><td>@x.EvidenceType</td><td>@(x.Supplier?.Name ?? x.PurchaseRequirement?.RequestCode ?? "—")</td><td>@x.SourceType</td><td><span class="tag">@x.Status</span></td><td>@x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td><a asp-action="Details" asp-route-id="@x.Id">جزئیات</a></td></tr>}@if(!Model.Any()){<tr><td colspan="7">هنوز مدرکی ثبت نشده است.</td></tr>}</tbody></table></div>
