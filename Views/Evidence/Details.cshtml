@model O2Ban.EnterprisePilot.Models.EvidenceRecord
<div class="pagehead"><div><div class="eyebrow">EVIDENCE RECORD #@Model.Id</div><h1>@Model.Title</h1><p>سوابق منبع، وضعیت اعتبارسنجی و فایل پشتیبان</p></div><a class="btn" asp-action="Index">بازگشت به فهرست</a></div>
<div class="panel"><div class="detail-grid"><div><small>وضعیت</small><strong>@Model.Status</strong></div><div><small>نوع مدرک</small><strong>@Model.EvidenceType</strong></div><div><small>منبع</small><strong>@Model.SourceType</strong></div><div><small>تأمین‌کننده</small><strong>@(Model.Supplier?.Name ?? "—")</strong></div><div><small>درخواست خرید</small><strong>@(Model.PurchaseRequirement?.RequestCode ?? "—")</strong></div><div><small>تاریخ ثبت</small><strong>@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</strong></div><div><small>انقضا</small><strong>@(Model.ExpiresAt?.ToString("yyyy/MM/dd") ?? "ثبت نشده")</strong></div><div><small>فایل</small><strong>@if(!string.IsNullOrEmpty(Model.StoredFileName)){<a asp-action="Download" asp-route-id="@Model.Id">دانلود @Model.OriginalFileName</a>}else{<text>بدون فایل پیوست</text>}</strong></div></div><h3>شرح</h3><p>@(string.IsNullOrWhiteSpace(Model.Description) ? "شرحی ثبت نشده است." : Model.Description)</p>@if(!string.IsNullOrWhiteSpace(Model.ReviewComment)){<h3>نظر بررسی‌کننده</h3><p>@Model.ReviewComment</p>}@if(Model.ReviewedAt.HasValue){<p class="muted">آخرین بررسی: @Model.ReviewedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</p>}</div>
@if(User.IsInRole("Admin")){<div class="panel"><h2>بررسی و تعیین وضعیت</h2><form asp-action="Review" method="post"><input type="hidden" name="id" value="@Model.Id"/><div class="formgrid"><label>نتیجه بررسی<select name="status">@foreach(var s in new[]{"در انتظار بررسی","اظهار تأمین‌کننده","استخراج‌شده از سند","تأیید مستقل","مبتنی بر معامله","نیازمند به‌روزرسانی","متناقض","مشکوک","ردشده"}){<option selected="@(Model.Status==s)" value="@s">@s</option>}</select></label><label>تاریخ انقضا<input type="date" name="expiresAt" value="@(Model.ExpiresAt?.ToString("yyyy-MM-dd"))"/></label><label class="wide">یادداشت بررسی<textarea name="reviewComment" maxlength="1000">@Model.ReviewComment</textarea></label></div><button class="btn" type="submit">ثبت نتیجه بررسی</button></form></div>}
