@model SupplierPerformanceProfileViewModel
<div class="pagehead"><div><p class="eyebrow">SUPPLIER INTELLIGENCE PROFILE</p><h1>@Model.Supplier.Name</h1><p>@Model.Supplier.City · @Model.Supplier.Capabilities</p></div><a class="btn" asp-action="Index" asp-route-supplierId="@Model.Supplier.Id">مشاهده سفارش‌ها</a></div>
<div class="stats"><div class="stat"><span>تعداد سفارش‌ها</span><strong>@Model.TotalOrders</strong></div><div class="stat"><span>سفارش‌های ارزیابی‌شده</span><strong>@Model.EvaluatedOrders</strong></div><div class="stat"><span>امتیاز عملکرد</span><strong>@(Model.AverageScore?.ToString("0.0") ?? "—")</strong></div><div class="stat"><span>تحویل به‌موقع</span><strong>@(Model.OnTimeRate.HasValue ? Model.OnTimeRate.Value.ToString("0.0") + "%" : "—")</strong></div></div>
<div class="stats"><div class="stat"><span>نرخ پذیرش کالا</span><strong>@(Model.AcceptanceRate.HasValue ? Model.AcceptanceRate.Value.ToString("0.0") + "%" : "—")</strong></div><div class="stat"><span>میانگین امتیاز کیفیت</span><strong>@(Model.AverageQualityRating?.ToString("0.0") ?? "—") / ۵</strong></div></div>
@if (Model.EvaluatedOrders == 0) { <div class="notice">این تأمین‌کننده هنوز سابقه ارزیابی پس از معامله ندارد. نبود سابقه به معنی عملکرد ضعیف یا رد صلاحیت نیست.</div> }
<div class="panel"><h2>آخرین سفارش‌ها</h2><table><thead><tr><th>سفارش</th><th>تاریخ</th><th>مقدار</th><th>وضعیت تحویل</th><th>امتیاز</th><th></th></tr></thead><tbody>@foreach (var o in Model.RecentOrders) { <tr><td>@o.OrderCode</td><td>@o.OrderDate.ToString("yyyy/MM/dd")</td><td>@o.OrderedQuantity</td><td>@o.DeliveryStatus</td><td>@(o.Evaluation == null ? "—" : o.Evaluation.OverallScore.ToString("0.0"))</td><td><a asp-action="Details" asp-route-id="@o.Id">جزئیات</a></td></tr> }@if (!Model.RecentOrders.Any()) { <tr><td colspan="6">سفارشی ثبت نشده است.</td></tr> }</tbody></table></div>
<div class="panel"><h2>آخرین ارزیابی‌ها</h2><table><thead><tr><th>تاریخ ارزیابی</th><th>کیفیت</th><th>تحویل</th><th>پاسخ‌گویی</th><th>مستندات</th><th>امتیاز نهایی</th><th>توضیحات</th></tr></thead><tbody>@foreach (var e in Model.RecentEvaluations) { <tr><td>@e.EvaluatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@e.QualityRating / ۵</td><td>@e.DeliveryScore / ۵</td><td>@e.CommunicationRating / ۵</td><td>@e.DocumentationRating / ۵</td><td>@e.OverallScore.ToString("0.00")</td><td class="payment-cell">@e.Comments</td></tr> }@if (!Model.RecentEvaluations.Any()) { <tr><td colspan="7">ارزیابی ثبت نشده است.</td></tr> }</tbody></table></div>
<div class="notice">این شاخص‌ها از سفارش‌ها و ارزیابی‌های ثبت‌شده در O2Ban محاسبه می‌شوند و تا زمانی که تعداد سفارش‌ها، دوره زمانی و شواهد کافی نباشد نباید به‌عنوان تضمین عملکرد آینده تفسیر شوند.</div>
