@model ProcurementOrder
<div class="pagehead"><div><p class="eyebrow">ORDER DELIVERY TRACKING</p><h1>جزئیات سفارش @Model.OrderCode</h1><p>@Model.Supplier?.Name · @Model.Requirement?.RequestCode · @Model.Requirement?.Item?.Name</p></div><a class="btn" asp-action="Index">بازگشت به سفارش‌ها</a></div>
@if (TempData["PerformanceSuccess"] is string success) { <div class="notice">@success</div> }
@if (TempData["PerformanceError"] is string error) { <div class="notice">@error</div> }
<div asp-validation-summary="All" class="validation"></div>
<div class="panel"><div class="detail-grid"><div><small>مقدار سفارش</small><strong>@Model.OrderedQuantity</strong></div><div><small>قیمت واحد</small><strong>@Model.UnitPrice.ToString("N0")</strong></div><div><small>تاریخ سفارش</small><strong>@Model.OrderDate.ToString("yyyy/MM/dd")</strong></div><div><small>تاریخ تحویل مورد انتظار</small><strong>@Model.ExpectedDeliveryDate.ToString("yyyy/MM/dd")</strong></div></div></div>
<div class="panel"><h2>ثبت و به‌روزرسانی اطلاعات تحویل</h2>
<form method="post" asp-action="UpdateDelivery" class="formgrid">
<input type="hidden" name="OrderId" value="@Model.Id" />
<label>وضعیت تحویل<select name="DeliveryStatus"><option selected="@(Model.DeliveryStatus == "در انتظار تحویل")">در انتظار تحویل</option><option selected="@(Model.DeliveryStatus == "تحویل جزئی")">تحویل جزئی</option><option selected="@(Model.DeliveryStatus == "تحویل کامل")">تحویل کامل</option><option selected="@(Model.DeliveryStatus == "لغوشده")">لغوشده</option></select></label>
<label>تاریخ دریافت واقعی<input type="date" name="ActualDeliveryDate" value="@(Model.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" /></label>
<label>مقدار دریافت‌شده<input type="number" step="0.001" min="0" max="@Model.OrderedQuantity" name="ReceivedQuantity" value="@Model.ReceivedQuantity" /></label>
<label>مقدار تأییدشده<input type="number" step="0.001" min="0" name="AcceptedQuantity" value="@Model.AcceptedQuantity" /></label>
<label>مقدار مردود / دارای مغایرت<input type="number" step="0.001" min="0" name="RejectedQuantity" value="@Model.RejectedQuantity" /></label>
<label class="wide">شرح مغایرت، تأخیر یا توضیحات تحویل<textarea name="DeliveryNotes">@Model.DeliveryNotes</textarea></label>
<button class="btn" type="submit" disabled="@(Model.Evaluation != null)">ذخیره اطلاعات تحویل</button>
</form>
@if (Model.Evaluation != null) { <p class="notice">این سفارش ارزیابی نهایی شده است؛ برای حفظ یکپارچگی سابقه، اطلاعات تحویل قفل شده‌اند.</p> }
</div>
@if (Model.DeliveryStatus == "تحویل کامل" && Model.ActualDeliveryDate.HasValue)
{
    <div class="panel"><h2>ارزیابی عملکرد تأمین‌کننده</h2>
    @if (Model.Evaluation != null) { <p>امتیاز نهایی: <strong>@Model.Evaluation.OverallScore.ToString("0.00") از ۱۰۰</strong> · تاریخ ارزیابی: @Model.Evaluation.EvaluatedAt.ToLocalTime().ToString("yyyy/MM/dd")</p> }
    @if (Model.Evaluation == null) { <a class="btn" asp-action="Evaluate" asp-route-id="@Model.Id">ثبت ارزیابی نهایی</a> }
    else { <p class="notice">این سفارش ارزیابی نهایی دارد: <strong>@Model.Evaluation.OverallScore.ToString("0.00") از ۱۰۰</strong>. ارزیابی پس از ثبت در این نسخه قابل بازنویسی نیست.</p> }
    </div>
}
else { <div class="notice">ارزیابی نهایی پس از ثبت تحویل کامل و تاریخ دریافت فعال می‌شود. برای تحویل جزئی، ابتدا وضعیت دریافت را به‌روزرسانی کنید.</div> }
