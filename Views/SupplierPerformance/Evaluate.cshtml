@model SupplierPerformanceEvaluationViewModel
<div class="pagehead"><div><p class="eyebrow">POST-DELIVERY EVALUATION</p><h1>ارزیابی تأمین‌کننده</h1><p>@Model.SupplierName · سفارش @Model.OrderCode</p></div></div>
<div class="notice">این ارزیابی باید بر اساس شواهد واقعی تحویل، کنترل کیفیت و تجربه اجرای سفارش ثبت شود؛ از امتیازدهی حدسی خودداری کنید.</div>
<div asp-validation-summary="All" class="validation"></div>
<div class="panel"><div class="detail-grid"><div><small>مقدار سفارش</small><strong>@Model.OrderedQuantity</strong></div><div><small>مقدار تأییدشده</small><strong>@Model.AcceptedQuantity</strong></div><div><small>تحویل مورد انتظار</small><strong>@Model.ExpectedDeliveryDate.ToString("yyyy/MM/dd")</strong></div><div><small>تحویل واقعی</small><strong>@Model.ActualDeliveryDate?.ToString("yyyy/MM/dd")</strong></div></div></div>
<form method="post" asp-action="Evaluate" class="panel formgrid">
<input type="hidden" asp-for="OrderId" />
<label>کیفیت کالا (۱ تا ۵)<select asp-for="QualityRating"><option value="1">۱ - بسیار ضعیف</option><option value="2">۲ - ضعیف</option><option value="3">۳ - قابل قبول</option><option value="4">۴ - خوب</option><option value="5">۵ - عالی</option></select></label>
<label>تعامل و پاسخ‌گویی (۱ تا ۵)<select asp-for="CommunicationRating"><option value="1">۱ - بسیار ضعیف</option><option value="2">۲ - ضعیف</option><option value="3">۳ - قابل قبول</option><option value="4">۴ - خوب</option><option value="5">۵ - عالی</option></select></label>
<label>کامل‌بودن مستندات (۱ تا ۵)<select asp-for="DocumentationRating"><option value="1">۱ - بسیار ضعیف</option><option value="2">۲ - ضعیف</option><option value="3">۳ - قابل قبول</option><option value="4">۴ - خوب</option><option value="5">۵ - عالی</option></select></label>
<label class="wide">توضیحات و شواهد ارزیابی<textarea asp-for="Comments" placeholder="مثلاً نتیجه کنترل کیفیت، تعداد مغایرت‌ها، نحوه پاسخ‌گویی و مستندات تحویل"></textarea></label>
<div class="wide"><button class="btn" type="submit">ثبت ارزیابی و محاسبه امتیاز</button> <a asp-action="Details" asp-route-id="@Model.OrderId">انصراف</a></div>
</form>
<div class="notice"><strong>روش محاسبه:</strong> کیفیت ۴۰٪، تحویل به‌موقع ۲۵٪، تحقق مقدار قابل‌قبول سفارش ۱۵٪، پاسخ‌گویی ۱۰٪ و مستندات ۱۰٪. امتیاز تأخیر از تاریخ واقعی و مورد انتظار محاسبه می‌شود. این وزن‌ها تنظیم اولیه اعتبارسنجی هستند و باید با واحد تأمین اعتبارسنجی شوند.</div>
