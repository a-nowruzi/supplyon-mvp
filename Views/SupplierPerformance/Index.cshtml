@model SupplierPerformanceIndexViewModel
<div class="pagehead"><div><p class="eyebrow">SUPPLIER PERFORMANCE</p><h1>عملکرد و ارزیابی تأمین‌کنندگان</h1><p>پیگیری سفارش‌های ثبت‌شده، تحویل کالا و ارزیابی پس از معامله</p></div><a class="btn" asp-controller="Suppliers" asp-action="Index">فهرست تأمین‌کنندگان</a></div>
@if (TempData["PerformanceSuccess"] is string success) { <div class="notice">@success</div> }
@if (TempData["PerformanceError"] is string error) { <div class="notice">@error</div> }
<div class="stats"><div class="stat"><span>کل سفارش‌ها</span><strong>@Model.TotalOrders</strong></div><div class="stat"><span>در انتظار / تحویل جزئی</span><strong>@Model.PendingOrders</strong></div><div class="stat"><span>تحویل کامل</span><strong>@Model.CompletedOrders</strong></div><div class="stat"><span>ارزیابی نهایی</span><strong>@Model.EvaluatedOrders</strong></div></div>
<div class="panel"><h2>سفارش‌ها و وضعیت عملکرد</h2><table><thead><tr><th>کد سفارش</th><th>تأمین‌کننده</th><th>درخواست</th><th>مقدار</th><th>تاریخ مورد انتظار</th><th>وضعیت تحویل</th><th>امتیاز نهایی</th><th></th></tr></thead><tbody>
@foreach (var order in Model.Orders) { <tr><td>@order.OrderCode</td><td><a asp-action="SupplierProfile" asp-route-supplierId="@order.SupplierId">@order.Supplier?.Name</a></td><td>@order.Requirement?.RequestCode · @order.Requirement?.Item?.Name</td><td>@order.OrderedQuantity</td><td>@order.ExpectedDeliveryDate.ToString("yyyy/MM/dd")</td><td><span class="tag">@order.DeliveryStatus</span></td><td>@(order.Evaluation == null ? "ثبت نشده" : order.Evaluation.OverallScore.ToString("0.00") + " / 100")</td><td><a asp-action="Details" asp-route-id="@order.Id">جزئیات</a></td></tr> }
@if (!Model.Orders.Any()) { <tr><td colspan="8">هنوز سفارشی از پیشنهادهای تأمین‌کنندگان ثبت نشده است. پس از تأیید فنی یک پیشنهاد، می‌توانید آن را به سفارش تبدیل کنید.</td></tr> }
</tbody></table></div>
<div class="notice">امتیاز عملکرد فقط از سفارش‌های ثبت‌شده و ارزیابی‌های تکمیل‌شده محاسبه می‌شود. تأمین‌کننده بدون سابقه معامله، امتیاز صفر یا رتبه منفی نمی‌گیرد؛ وضعیت او «فاقد سابقه ارزیابی» است.</div>
